# ─── App ───────────────────────────────────────────────
NODE_ENV=development
APP_PORT=3000

# ─── Database ──────────────────────────────────────────
POSTGRES_USER=logistica_user
POSTGRES_PASSWORD=logistica_pass
POSTGRES_DB=logistica_db
POSTGRES_PORT=5432

# URL que usa Prisma para conectarse (se construye automáticamente en docker-compose)
# En local sin Docker, define esta variable manualmente:
DATABASE_URL=postgresql://logistica_user:logistica_pass@localhost:5432/logistica_db

# ─── Redis ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT ───────────────────────────────────────────────
JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRES_IN=7d
